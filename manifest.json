{
  "manifest_version": 3,
  "name": "WiFi & Internet Speed Test",
  "version": "1.2.0",
  "description": "Lightweight, native network speed telemetry (Latency, Jitter, Download, Upload) powered by Cloudflare Edge.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Speed Test",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://speed.cloudflare.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
